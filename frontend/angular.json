{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "kadr": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{"type": "initial", "maximumWarning": "500kB", "maximumError": "800kB"}]
            },
            "development": {"optimization": false, "sourceMap": true, "extractLicenses": false}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"proxyConfig": "proxy.conf.json"},
          "configurations": {
            "development": {"buildTarget": "kadr:build:development"},
            "production": {"buildTarget": "kadr:build:production"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
